# App Store Connect API credentials.
# Create these in App Store Connect: Users and Access > Integrations > App Store Connect API.
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=

# Either set the private key text directly, or point to a .p8 file.
APP_STORE_CONNECT_PRIVATE_KEY=
APP_STORE_CONNECT_PRIVATE_KEY_PATH=

# Logs are JSON lines written to stderr so stdio MCP protocol output stays clean.
# Supported levels: debug, info, warn, error.
XCODECLOUD_MCP_LOG_LEVEL=debug

# Optional HTTP transport settings.
# Use these when running the server as a URL-backed MCP server.
XCODECLOUD_MCP_TRANSPORT=http
XCODECLOUD_MCP_PORT=3000
XCODECLOUD_MCP_ENDPOINT=/mcp
XCODECLOUD_MCP_BEARER_TOKEN=
